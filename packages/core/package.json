{
  "name": "@karkardmitry/kadmium-core",
  "version": "0.1.0",
  "description": "Metadata layer for TypeScript ORM",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "kadmium": "./dist/src/bin/kadmium.js"
  },
  "files": ["dist"],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-dts.mjs",
    "lint": "eslint src/",
    "check:type": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@karkardmitry/kadmium-sql-types": "^0.1.0",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3",
    "vitest": "^3.1.0"
  }
}
