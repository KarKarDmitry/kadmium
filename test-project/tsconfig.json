{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
  },
  "ts-node": {
    "transpileOnly": true,
  },
  "include": ["src/**/*", ".types/**/*", "test/**/*"],
  "exclude": ["node_modules"],
}
