{
  "name": "kadmium",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/sql-types",
    "packages/sql-pg"
  ],
  "scripts": {
    "build": "npm run build -w packages/core",
    "lint": "eslint packages/core/src/",
    "lint:fix": "eslint packages/core/src/ --fix",
    "check:type": "tsc --noEmit -p packages/core/tsconfig.json",
    "format": "prettier --write \"packages/core/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/core/src/**/*.ts\"",
    "test:project": "cd test-project && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
